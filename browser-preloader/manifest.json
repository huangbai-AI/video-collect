{
  "manifest_version": 3,
  "name": "选题中台 · 顺序预加载",
  "version": "1.0.0",
  "description": "按当前资料列表，低频预先打开后五个原帖，沿用浏览器登录态。",
  "key": "",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  }
}